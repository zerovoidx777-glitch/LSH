local ToggleBtn = Instance.new("TextButton", ScreenGui)
ToggleBtn.Size, ToggleBtn.Position, ToggleBtn.Text = UDim2.new(0, 50, 0, 50), UDim2.new(0.05, 0, 0.2, 0), "LS"
ToggleBtn.BackgroundColor3, ToggleBtn.TextColor3 = Color3.fromRGB(0, 150, 255), Color3.new(1,1,1)
